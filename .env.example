# ──────────────────────────────────────────
# LifeOS AI — Environment Variables (EXEMPLO)
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA vai para o Git.
# Em produção (Vercel): Project → Settings → Environment Variables
# ──────────────────────────────────────────

# DeepSeek AI — Provedor principal de IA
DEEPSEEK_API_KEY="sk-..."

# Gemini (fallback opcional)
GEMINI_API_KEY=""

# Telegram Bot Token (obtido via @BotFather no Telegram)
TELEGRAM_BOT_TOKEN="1234567890:AAF..."

# Seu Telegram Chat ID pessoal (obtido via @userinfobot)
TELEGRAM_CHAT_ID=""

# URL pública do sistema (necessário para webhook real do Telegram)
# Exemplo Vercel: https://lifeos-ai.vercel.app
APP_URL="http://localhost:3000"

# Supabase (opcional para persistência em nuvem)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

